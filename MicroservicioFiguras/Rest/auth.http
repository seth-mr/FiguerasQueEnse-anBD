@authHost = http://localhost:5041
@figuresHost = http://localhost:5124

### 1. Registrar tutor (solo la primera vez)
POST {{authHost}}/auth/register
Content-Type: application/json

{
  "name": "Carlos Ramirez",
  "email": "android@example.com",
  "password": "TutorPass123!",
  "role": "tutor",
  "country": "CO",
  "degree": "padre-madre",
  "neurodivergency": "None",
  "age": 30,
  "gender": "M"
}

###

### 2. Registrar estudiante (solo la primera vez)
POST {{authHost}}/auth/register
Content-Type: application/json

{
  "name": "Ana Lopez",
  "email": "gabo@example.com",
  "password": "StudentPass123@",
  "role": "student",
  "country": "CO",
  "neurodivergency": "None",
  "age": 10,
  "gender": "F"
}

###

### 3. Login tutor
POST {{authHost}}/auth/login
Content-Type: application/json

{
  "email": "android@example.com",
  "password": "TutorPass123!"
}

###

### 4. Login estudiante
POST {{authHost}}/auth/login
Content-Type: application/json

{
  "email": "gabo@example.com",
  "password": "StudentPass123@"
}

###

### 5. Asignar tutor al estudiante (requiere token de tutor)
@tutorToken = eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMyIsImVtYWlsIjoiYW5kcm9pZEBleGFtcGxlLmNvbSIsInJvbGUiOiJ0dXRvciIsImlzcyI6ImZpZ3VyYXNxZS1hdXRoIiwiYXVkIjoiZmlndXJhc3FlLWNsaWVudCIsImlhdCI6MTc3ODUzMTYwOCwiZXhwIjoxNzc4NTM1MjA4fQ.VTweSaHfQn_oJiYPuK8USinXOdy5AQKSd4T7M56zF1A
POST {{figuresHost}}/tutors/assign-student
Authorization: Bearer {{tutorToken}}
Content-Type: application/json

{
  "studentEmail": "gabo@example.com",
  "tutorEmail": "android@example.com"
}

